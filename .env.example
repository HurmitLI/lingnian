APP_ENV=development
BACKEND_PORT=8011
FRONTEND_ORIGIN=http://127.0.0.1:3011
DATABASE_URL=sqlite:///./data/db/niannian.db
ASSET_ROOT=./data
MAX_AUDIO_BYTES=209715200

# Development defaults are offline and safe for fictional test data.
ASR_PROVIDER=mock
ASR_MODEL_ID=paraformer-zh
FFMPEG_BINARY=
MODEL_CACHE_ROOT=./backend/.model-cache

LLM_PROVIDER=mock
LLM_MODEL=qwen3.7-plus-2026-05-26
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Fourth-stage local keepsake rendering. No cloud media provider or new API key is used.
KEEPSAKE_MAX_STORIES=10
KEEPSAKE_MAX_SOURCE_SECONDS=1800
KEEPSAKE_WIDTH=1280
KEEPSAKE_HEIGHT=720
KEEPSAKE_FFMPEG_TIMEOUT_SECONDS=900
