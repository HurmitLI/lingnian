# 正式后端地址，不要填写前端网址。
LINGNIAN_BACKEND_URL=https://example.apigateway-cn-beijing.volceapi.com

# 推荐运行 `lingnian-worker credential-set` 写入系统凭据库，不要把密钥写进这个文件。
# LINGNIAN_NODE_TOKEN=

LINGNIAN_COMFYUI_URL=http://127.0.0.1:8188
LINGNIAN_WORK_DIR=.worker-data
LINGNIAN_SCENE_WORKFLOW=workflows/documentary-scene-api.json
LINGNIAN_POLL_SECONDS=8
LINGNIAN_COMFY_TIMEOUT_SECONDS=1800
LINGNIAN_MAX_GENERATION_SECONDS=5
LINGNIAN_CAPABILITIES=scene_video
