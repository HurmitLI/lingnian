# 正式版只允许通过 HTTPS 访问；所有真实值请配置在云端加密环境变量中。
APP_ENV=production
FORMAL_AUTH_REQUIRED=true
FORMAL_INVITE_CODE=replace-with-a-long-random-invitation-code
FORMAL_ARCHIVE_MASTER_KEY=replace-with-base64-encoded-32-byte-key
FORMAL_PERSISTENT_STORAGE_MOUNT=/mnt/lingnian
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAME=lingnian_session
AUTH_SESSION_DAYS=30

# NAS 挂载目录：数据库和媒体必须都落在持久存储中。
DATABASE_URL=sqlite:////mnt/lingnian/db/lingnian.db
ASSET_ROOT=/mnt/lingnian

# 正式版使用云端语音识别、文字整理和自然语音。
ASR_PROVIDER=dashscope
ASR_MODEL_ID=paraformer-realtime-v2
LLM_PROVIDER=qwen
LLM_API_KEY=replace-in-cloud-secret-settings
TTS_PROVIDER=dashscope

# 前端正式域名，上线时替换。
FRONTEND_ORIGIN=https://replace-with-formal-frontend.example.com
